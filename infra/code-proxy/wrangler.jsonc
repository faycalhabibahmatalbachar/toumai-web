{
  "name": "toumai-code-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "code.toumaiai.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "TOUMAI_CODE_ORIGIN": "https://toumai-code-theia-preview.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
